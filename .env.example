# PayPal REST app credentials. Use sandbox for testing and live for production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Resend transactional email configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Master key for encrypting each customer's PayPal / Resend secrets in D1.
# Use a random value with at least 32 characters; never commit the real value.
CMS_SECRETS_KEY=
